+                # Test like post
+                like_response = requests.post(f"{API_URL}/forum/posts/{post_id}/like", headers=headers, timeout=30)
+                
+                if like_response.status_code == 200:
+                    like_data = like_response.json()
+                    if "message" in like_data:
